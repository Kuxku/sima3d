# ==========================================
# SIMA-3D API - Variables de Entorno (.env)
# ==========================================

# Credencial de Gemini API (Solo Backend, NUNCA en el Frontend)
GEMINI_API_KEY="AIzaSy_TU_CLAVE_DE_GEMINI_AQUI"

# Modelo Convencional (Modo 1 Económico y Copilot Chat)
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TEMPERATURE=0.1
COPILOT_MAX_PROMPT_CHARS=500

# Parámetros Modo 1 - Voz Económica
VOICE_MAX_TRANSCRIPT_CHARS=350
VOICE_CONVENTIONAL_RATE_LIMIT_PER_MINUTE=30

# Parámetros Modo 2 - Gemini Multimodal Live API (WebSockets)
# Modelo de alta disponibilidad con soporte verificado para bidiGenerateContent
GEMINI_LIVE_MODEL="gemini-2.5-flash-native-audio-latest"
GEMINI_LIVE_VOICE_NAME="Puck"
GEMINI_VOICE_LANGUAGE="es-CO"
VOICE_LIVE_MAX_CONCURRENT_SESSIONS=3
VOICE_LIVE_MAX_DURATION_SECONDS=900
VOICE_LIVE_INACTIVITY_TIMEOUT_SECONDS=60
VOICE_LIVE_MAX_RECONNECT_ATTEMPTS=3

# Rutas y CORS
GRAPH_DATA_PATH="../data/processed/grafo_3d.json"
CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
